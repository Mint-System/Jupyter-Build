              "cell_type": "code",
              "content": "import json\nimport ssl\nimport urllib.request\nimport urllib.error\nimport pandas as pd\nfrom pathlib import Path\n\nODOO_URL = \"https://jupyter-lab.19.odoo.build/\"\nODOO_DB = \"jupyter-lab\"\nODOO_USERNAME = \"login@mint-system.ch\"\nODOO_PASSWORD = \"5a78545dbde09f0e19a818acdf45efa98673f36a\"\n\nINPUT_DIR = Path(\"input\")\nINPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nssl_ctx = ssl.create_default_context()\nssl_ctx.check_hostname = False\nssl_ctx.verify_mode = ssl.CERT_NONE\n\ndef jsonrpc_call(url, params, bearer_token=None):\n    payload = json.dumps({\n        \"jsonrpc\": \"2.0\",\n        \"method\": \"call\",\n        \"params\": params,\n        \"id\": 1,\n    }).encode()\n    headers = {\"Content-Type\": \"application/json\"}\n    if bearer_token:\n        headers[\"Authorization\"] = f\"Bearer {bearer_token}\"\n    req = urllib.request.Request(url, data=payload, headers=headers)\n    try:\n        with urllib.request.urlopen(req, context=ssl_ctx) as resp:\n            result = json.loads(resp.read())\n            if result.get(\"error\"):\n                raise Exception(result[\"error\"])\n            return result.get(\"result\")\n    except urllib.error.HTTPError as e:\n        raise Exception(f\"HTTP {e.code}: {e.read().decode()}\")\n\nprint(\"Setup complete.\")",
              "cell_id": "f3bd2c47-6c83-47cc-9148-1ad15ba604ab"
            }
          },
          {
            "raw_input": {
              "cell_id": "e79cae70-710a-41a1-b416-f5f3101cd763",
              "cell_type": "code",
              "file_path": "/home/janikvonrotz/jupyter-build/extract.ipynb",
              "content": "result = jsonrpc_call(\n    f\"{ODOO_URL.rstrip('/')}/json/2/res.partner/search\",\n    {\"args\": [[]], \"kwargs\": {}},\n    bearer_token=ODOO_PASSWORD,\n)\nprint(f\"Found {len(result)} contacts via JSON-2 API with Bearer auth.\")"
            },
            "title": "Jupyter_MCP_Server_edit_cell",
            "raw_output": {
              "metadata": {
                "truncated": false
              },
              "output": "{\"success\":true}"
