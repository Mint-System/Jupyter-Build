                  "text": "#!/usr/bin/env bash\nset -e\n\nhelp-table() {\n    local -a rows\n    local max_cmd=7 max_opt=6 max_desc=11\n\n    rows+=(\"Command|Option|Description\")\n    rows+=(\"install||Install Python packages.\")\n    rows+=(\"start|[env]|Start Jupyter Lab.\")\n    rows+=(\"list-env||List .env files.\")\n    rows+=(\"load-env|[env]|Load and export .env file.\")\n    rows+=(\"run|<path>[env]|Run Jupyter notebok.\")\n    rows+=(\"exec-entrypoint-jupyter||Start Jupyter Lab inside container.\")\n    rows+=(\"run-container|<path>|Run Jupyter Lab in Docker container.\")\n\n    for row in \"${rows[@]}\"; do\n        IFS='|' read -r cmd opt desc <<< \"$row\"\n        (( ${#cmd} > max_cmd )) && max_cmd=${#cmd}\n        (( ${#opt} > max_opt )) && max_opt=${#opt}\n        (( ${#desc} > max_desc )) && max_desc=${#desc}\n    done\n\n    printf '| %-*s | %-*s | %-*s |\\n' \\\n        \"$max_cmd\" \"Command\" \\\n        \"$max_opt\" \"Option\" \\\n        \"$max_desc\" \"Description\"\n\n    printf '|-%*s-|-%*s-|-%*s-|\\n' \\\n        \"$max_cmd\" \"$(printf '%*s' \"$max_cmd\" '' | tr ' ' '-')\" \\\n        \"$max_opt\" \"$(printf '%*s' \"$max_opt\" '' | tr ' ' '-')\" \\\n        \"$max_desc\" \"$(printf '%*s' \"$max_desc\" '' | tr ' ' '-')\"\n\n    local first_row=true\n    for row in \"${rows[@]:1}\"; do\n        IFS='|' read -r cmd opt desc <<< \"$row\"\n        if [[ \"$cmd\" =~ ^===.*===$ ]]; then\n            group_name=\"${cmd/===/}\"\n            group_name=\"${group_name/===/}\"\n            \n            if [ \"$first_row\" = true ]; then\n                first_row=false\n            else\n                printf '|-%*s-|-%*s-|-%*s-|\\n' \\\n                    \"$max_cmd\" \"$(printf '%*s' \"$max_cmd\" '' | tr ' ' '-')\" \\\n                    \"$max_opt\" \"$(printf '%*s' \"$max_opt\" '' | tr ' ' '-')\" \\\n                    \"$max_desc\" \"$(printf '%*s' \"$max_desc\" '' | tr ' ' '-')\"\n            fi\n            \n            local left_pad=$(( (max_cmd - ${#group_name}) / 2 ))\n            local right_pad=$(( max_cmd - left_pad - ${#group_name} ))\n            printf '| %*s%s%*s | %*s | %*s |\\n' \\\n                \"$left_pad\" \"\" \\\n                \"$group_name\" \\\n                \"$right_pad\" \"\" \\\n                \"$max_opt\" \"\" \\\n                \"$max_desc\" \"\"\n            \n            printf '|-%*s-|-%*s-|-%*s-|\\n' \\\n                \"$max_cmd\" \"$(printf '%*s' \"$max_cmd\" '' | tr ' ' '-')\" \\\n                \"$max_opt\" \"$(printf '%*s' \"$max_opt\" '' | tr ' ' '-')\" \\\n                \"$max_desc\" \"$(printf '%*s' \"$max_desc\" '' | tr ' ' '-')\"\n        else\n            first_row=false\n            printf '| %-*s | %-*s | %-*s |\\n' \\\n                \"$max_cmd\" \"$cmd\" \\\n                \"$max_opt\" \"$opt\" \\\n                \"$max_desc\" \"$desc\"\n        fi\n    done\n}\n\nhelp() {\n    local grep_pattern\n    echo\n    if [[ -n \"$1\" ]]; then\n        grep_pattern=\"$1\"\n        help-table | grep -i \"$grep_pattern\" | column -t -s'|'\n    else\n        echo \"task <command> [options]\"\n        echo\n        echo \"commands:\"\n        echo\n        help-table\n    fi\n    echo\n}\n\nTASK_DOTENV_DIR=\"$HOME/Odoo-Build/vault\"\n\nif [[ -d \"$HOME/taskfile.build/bin\" ]]; then\n    for file in \"$HOME/taskfile.build/bin/\"*; do\n        if [[ -f \"$file\" ]]; then\n            # shellcheck disable=SC1090\n            source \"$file\"\n        fi\n    done\nfi\n\ninstall() {\n    uv_venv=\"${VENV_PATH:-.venv}\"\n    uv venv \"$uv_venv\" --clear\n    source \"$uv_venv/bin/activate\"\n    uv pip install -r requirements.txt\n}\n\nrun() {\n    uv_venv=\"${VENV_PATH:-.venv}\"\n    source \"$uv_venv/bin/activate\"\n\n    if [[ -z \"$1\" ]]; then\n        echo '$1/path is empty.'\n        exit\n    fi\n    if [[ -n \"$2\" ]]; then\n        echo \"Load env file $2.\"\n        load-dotenv \"$2\"\n        export ODOO_URL\n        export ODOO_DATABASE\n        export ODOO_USERNAME\n        export ODOO_PASSWORD\n    fi\n    papermill --log-output \"$1\" \"$1\"\n}\n\nstart() {\n    uv_venv=\"${VENV_PATH:-.venv}\"\n    source \"$uv_venv/bin/activate\"\n\n    if [[ -n \"$1\" ]]; then\n        echo \"Load env file $1.\"\n        load-dotenv \"$1\"\n        export ODOO_URL\n        export ODOO_DATABASE\n        export ODOO_USERNAME\n        export ODOO_PASSWORD\n    fi\n    jupyter lab\n}\n\nexec-entrypoint-jupyter() {\n    uv_venv=\"${VENV_PATH:-.venv}\"\n    source \"$uv_venv/bin/activate\"\n\n    jupyter lab \\\n        --ip=${JUPYTER_HOST:-localhost} \\\n        --port=${JUPYTER_PORT:-8888} \\\n        --IdentityProvider.token=${JUPYTER_TOKEN:-\"\"} \\\n        --allow-root\n}\n\nrun-container() {\n    container_name=\"jupyter-build\"\n    image_tag=\"mintsystem/taskfile.build:latest\"\n\n    docker pull \"$image_tag\"\n    docker rm -f \"$container_name\"\n\n    JUPYTER_TOKEN=\"etooSheese5eedae1mid\"\n    echo \"Open http://localhost:8888/lab?token=$JUPYTER_TOKEN in your browser\"\n    docker run -p 8888:80 -d \\\n        --name \"$container_name\" \\\n        -e VENV_PATH=\"/app/.venv\" \\\n        -e TASK_COMMANDS=\"install\" \\\n        -e JUPYTER_HOST=\"0.0.0.0\" \\\n        -e JUPYTER_TOKEN=\"$JUPYTER_TOKEN\" \\\n        -e JUPYTER_PORT=\"80\" \\\n        -v \"$(pwd):/app/repo\" \\\n        \"$image_tag\" \\\n        ./task exec-entrypoint-jupyter\n}\n\nif [[ \"$1\" == *\",\"* ]]; then\n    # Split comma-separated commands\n    IFS=',' read -ra COMMANDS <<< \"$1\"\n    for cmd in \"${COMMANDS[@]}\"; do\n        # Trim whitespace\n        cmd=$(echo \"$cmd\" | xargs)\n        if declare -f \"$cmd\" > /dev/null; then\n            \"$cmd\"\n        else\n            echo \"Unknown command: $cmd\"\n            help \"$@\"\n            exit 1\n        fi\n    done\nelif declare -f \"$1\" > /dev/null; then\n    \"$1\" \"${@:2}\"\nelse\n    case \"$1\" in\n        *)\n            echo \"Unknown command: $1\"\n            exit 1\n            ;;\n    esac\nfi",
