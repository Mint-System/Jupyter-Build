  -e JUPYTER_HOST=\"0.0.0.0\" \\\n166:         -e JUPYTER_TOKEN=\"$JUPYTER_TOKEN\" \\\n167:         -e JUPYTER_PORT=\"80\" \\\n168:         -v \"$(pwd):/app/repo\" \\\n169:         \"$image_tag\" \\\n170:         ./task exec-entrypoint-jupyter\n171: }\n172: \n173: if [[ \"$1\" == *\",\"* ]]; then\n174:     # Split comma-separated commands\n175:     IFS=',' read -ra COMMANDS <<< \"$1\"\n176:     for cmd in \"${COMMANDS[@]}\"; do\n177:         # Trim whitespace\n178:         cmd=$(echo \"$cmd\" | xargs)\n179:         if declare -f \"$cmd\" > /dev/null; then\n180:             \"$cmd\"\n181:         else\n182:             echo \"Unknown command: $cmd\"\n183:             help \"$@\"\n184:             exit 1\n185:         fi\n186:     done\n187: elif declare -f \"$1\" > /dev/null; then\n188:     \"$1\" \"${@:2}\"\n189: else\n190:     case \"$1\" in\n191:         *)\n192:             echo \"Unknown command: $1\"\n193:             exit 1\n194:             ;;\n195:     esac\n196: fi\n\n(End of file - total 196 lines)\n</content>"
