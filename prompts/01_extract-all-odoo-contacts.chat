              "file_path": "/home/janikvonrotz/jupyter-build/extract.ipynb",
              "content": "uid = jsonrpc_call(\"/json/2/auth/login\", {\n    \"db\": ODOO_DB,\n    \"login\": ODOO_USERNAME,\n    \"password\": ODOO_PASSWORD,\n})\nprint(f\"Authenticated as user ID: {uid}\")"
