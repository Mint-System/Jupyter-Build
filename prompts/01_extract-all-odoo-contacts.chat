ntext()\\nssl_ctx.check_hostname = False\\nssl_ctx.verify_mode = ssl.CERT_NONE\\n\\ndef json2_call(model, method, params, bearer_token=None):\\n    url = f\\\"{ODOO_URL.rstrip('/')}/json/2/{model}/{method}\\\"\\n    payload = json.dumps(params).encode()\\n    headers = {\\\"Content-Type\\\": \\\"application/json\\\"}\\n    if bearer_token:\\n        headers[\\\"Authorization\\\"] = f\\\"Bearer {bearer_token}\\\"\\n    req = urllib.request.Request(url, data=payload, headers=headers)\\n    try:\\n        with urllib.request.urlopen(req, context=ssl_ctx) as resp:\\n            result = json.loads(resp.read())\\n            return result\\n    except urllib.error.HTTPError as e:\\n        raise Exception(f\\\"HTTP {e.code}: {e.read().decode()}\\\")\\n\\nprint(\\\"Setup complete.\\\")```\\n\\n#### Output\\n\\n```\\nSetup complete.\\n```\\n\\n### Cell 2\\n\\n#### Metadata\\n\\n```yaml\\nexecution:\\n  iopub.execute_input: '2026-06-24T14:13:40.324548Z'\\n  iopub.status.busy: '2026-06-24T14:13:40.324367Z'\\n  iopub.status.idle: '2026-06-24T14:13:40.503706Z'\\n  shell.execute_reply: '2026-06-24T14:13:40.503093Z'\\nexecution_count: 2\\npapermill:\\n  duration: 0.180707\\n  end_time: '2026-06-24T14:13:40.504059+00:00'\\n  exception: false\\n  start_time: '2026-06-24T14:13:40.323352+00:00'\\n  status: completed\\ntags: []\\ntype: code\\n```\\n\\n#### Source\\n\\n```python\\nresult = json2_call(\\\"res.partner\\\", \\\"search\\\", {\\\"domain\\\": [], \\\"offset\\\": 0}, bearer_token=ODOO_PASSWORD)\\nprint(f\\\"Found {len(result)} contacts.\\\")```\\n\\n#### Output\\n\\n```\\nFound 38 contacts.\\n```\\n\\n### Cell 3\\n\\n#### Metadata\\n\\n```yaml\\ntags:\\n- papermill-error-cell-tag\\ntype: markdown\\n```\\n\\n#### Source\\n\\n```\\n<span id=\\\"papermill-error-cell\\\" style=\\\"color:red; font-family:Helvetica Neue, Helvetica, Arial, sans-serif; font-size:2em;\\\">Execution using papermill encountered an exception here and stopped:</span>```\\n\\n### Cell 4\\n\\n#### Metadata\\n\\n```yaml\\nexecution:\\n  iopub.execute_input: '2026-06-24T14:13:40.514177Z'\\n  iopub.status.busy: '2026-06-24T14:13:40.513818Z'\\n  iopub.status.idle: '2026-06-24T14:13:40.549727Z'\\n  shell.execute_reply: '2026-06-24T14:13:40.549231Z'\\nexecution_count: 3\\npapermill:\\n  duration: 0.045595\\n  end_time: '2026-06-24T14:13:40.550310+00:00'\\n  exception: true\\n  start_time: '2026-06-24T14:13:40.504715+00:00'\\n  status: failed\\ntags: []\\ntype: code\\n```\\n\\n#### Source\\n\\n```python\\nfields = [\\\"id\\\", \\\"company_type\\\", \\\"name\\\", \\\"email\\\", \\\"type\\\", \\\"parent_id\\\"]\\n\\npartner_ids = jsonrpc_call(\\\"object\\\", \\\"execute_kw\\\", {\\n    \\\"db\\\": ODOO_DB,\\n    \\\"uid\\\": uid,\\n    \\\"password\\\": ODOO_PASSWORD,\\n    \\\"model\\\": \\\"res.partner\\\",\\n    \\\"method\\\": \\\"search\\\",\\n    \\\"args\\\": [[]],\\n    \\\"kwargs\\\": {},\\n})\\n\\nprint(f\\\"Found {len(partner_ids)} contacts.\\\")\\n\\ncontacts = []\\nBATCH_SIZE = 200\\nfor i in range(0, len(partner_ids), BATCH_SIZE):\\n    batch = partner_ids[i:i + BATCH_SIZE]\\n    records = jsonrpc_call(\\\"object\\\", \\\"execute_kw\\\", {\\n        \\\"db\\\": ODOO_DB,\\n        \\\"uid\\\": uid,\\n        \\\"password\\\": ODOO_PASSWORD,\\n        \\\"model\\\": \\\"res.partner\\\",\\n        \\\"method\\\": \\\"read\\\",\\n        \\\"args\\\": [batch],\\n        \\\"kwargs\\\": {\\\"fields\\\": fields},\\n    })\\n    contacts.extend(records)\\n\\ndf = pd.DataFrame(contacts)\\ndf.to_csv(INPUT_DIR / \\\"res.partner.csv\\\", index=False)\\nprint(f\\\"Exported {len(df)} contacts to input/res.partner.csv\\\")```\\n\\n#### Output\\n\\n```\\n\\u001b[31m---------------------------------------------------------------------------\\u001b[39m\\n\\u001b[31mNameError\\u001b[39m                                 Traceback (most recent call last)\\n\\u001b[36mCell\\u001b[39m\\u001b[36m \\u001b[39m\\u001b[32mIn[3]\\u001b[39m\\u001b[32m, line 3\\u001b[39m\\n\\u001b[32m      1\