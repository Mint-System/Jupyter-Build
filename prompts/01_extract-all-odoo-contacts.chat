            "raw_input": {
              "file_path": "/home/janikvonrotz/jupyter-build/extract.ipynb",
              "content": "fields = [\"id\", \"company_type\", \"name\", \"email\", \"type\", \"parent_id\"]\n\npartner_ids = jsonrpc_call(\n    f\"{ODOO_URL.rstrip('/')}/json/2/res.partner/search\",\n    {\"args\": [[]], \"kwargs\": {}},\n    bearer_token=ODOO_PASSWORD,\n)\nprint(f\"Found {len(partner_ids)} contacts.\")\n\ncontacts = []\nBATCH_SIZE = 200\nfor i in range(0, len(partner_ids), BATCH_SIZE):\n    batch = partner_ids[i:i + BATCH_SIZE]\n    records = jsonrpc_call(\n        f\"{ODOO_URL.rstrip('/')}/json/2/res.partner/read\",\n        {\"args\": [batch], \"kwargs\": {\"fields\": fields}},\n        bearer_token=ODOO_PASSWORD,\n    )\n    contacts.extend(records)\n\ndf = pd.DataFrame(contacts)\ndf.to_csv(INPUT_DIR / \"res.partner.csv\", index=False)\nprint(f\"Exported {len(df)} contacts to input/res.partner.csv\")",
              "cell_type": "code",
