r_token:\\n        headers[\\\"Authorization\\\"] = f\\\"Bearer {bearer_token}\\\"\\n    req = urllib.request.Request(url, data=payload, headers=headers)\\n    try:\\n        with urllib.request.urlopen(req, context=ssl_ctx) as resp:\\n            result = json.loads(resp.read())\\n            return result\\n    except urllib.error.HTTPError as e:\\n        raise Exception(f\\\"HTTP {e.code}: {e.read().decode()}\\\")\\n\\nprint(\\\"Setup complete.\\\")```\\n\\n### Cell 1\\n\\n#### Metadata\\n\\n```yaml\\nexecution:\\n  iopub.execute_input: '2026-06-24T14:14:45.975731Z'\\n  iopub.status.busy: '2026-06-24T14:14:45.975469Z'\\n  iopub.status.idle: '2026-06-24T14:14:46.127972Z'\\n  shell.execute_reply: '2026-06-24T14:14:46.127308Z'\\nexecution_count: 2\\npapermill:\\n  duration: 0.162097\\n  end_time: '2026-06-24T14:14:46.128445+00:00'\\n  exception: false\\n  start_time: '2026-06-24T14:14:45.966348+00:00'\\n  status: completed\\ntags: []\\ntype: code\\n```\\n\\n#### Source\\n\\n```python\\nresult = json2_call(\\\"res.partner\\\", \\\"search\\\", {\\\"domain\\\": [], \\\"offset\\\": 0}, bearer_token=ODOO_PASSWORD)\\nprint(f\\\"Found {len(result)} contacts.\\\")```\\n\\n### Cell 2\\n\\n#### Metadata\\n\\n```yaml\\nexecution:\\n  iopub.execute_input: '2026-06-24T14:14:46.130942Z'\\n  iopub.status.busy: '2026-06-24T14:14:46.130761Z'\\n  iopub.status.idle: '2026-06-24T14:14:46.679884Z'\\n  shell.execute_reply: '2026-06-24T14:14:46.679509Z'\\nexecution_count: 3\\npapermill:\\n  duration: 0.551265\\n  end_time: '2026-06-24T14:14:46.680590+00:00'\\n  exception: false\\n  start_time: '2026-06-24T14:14:46.129325+00:00'\\n  status: completed\\ntags: []\\ntype: code\\n```\\n\\n#### Source\\n\\n```python\\nfields = [\\\"company_type\\\", \\\"name\\\", \\\"email\\\", \\\"type\\\", \\\"parent_id\\\"]\\n\\npartner_ids = json2_call(\\\"res.partner\\\", \\\"search\\\", {\\\"domain\\\": [], \\\"offset\\\": 0}, bearer_token=ODOO_PASSWORD)\\nprint(f\\\"Found {len(partner_ids)} contacts.\\\")\\n\\nxml_id_map = json2_call(\\\"res.partner\\\", \\\"get_external_id\\\", {\\\"ids\\\": partner_ids}, bearer_token=ODOO_PASSWORD)\\n\\ncontacts = []\\nBATCH_SIZE = 200\\nfor i in range(0, len(partner_ids), BATCH_SIZE):\\n    batch = partner_ids[i:i + BATCH_SIZE]\\n    records = json2_call(\\\"res.partner\\\", \\\"read\\\", {\\\"ids\\\": batch, \\\"fields\\\": fields}, bearer_token=ODOO_PASSWORD)\\n    for rec in records:\\n        db_id = rec[\\\"id\\\"]\\n        rec[\\\"id\\\"] = xml_id_map.get(db_id) or db_id\\n        if isinstance(rec.get(\\\"parent_id\\\"), list) and len(rec[\\\"parent_id\\\"]) == 2:\\n            rec[\\\"parent_id\\\"] = rec[\\\"parent_id\\\"][0]\\n    contacts.extend(records)\\n\\ndf = pd.DataFrame(contacts)\\ndf.to_csv(INPUT_DIR / \\\"res.partner.csv\\\", index=False)\\nprint(f\\\"Exported {len(df)} contacts to input/res.partner.csv\\\")```\"}",
